{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "core-node/src/main/resources/static/**",
      "*.json",
      "!core-node/src/main/resources/static/assets/**",
      "!**/target/**",
      "!**/build/**",
      "!**/.gradle/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
