[Unit]
Description=Portfolio OS Core Node (Java 27 / Spring Boot)
After=network.target portfolio-os-quant.service
PartOf=portfolio-os.target

[Service]
Type=simple
WorkingDirectory=/home/rakeshpc/Projects/portfolio-os/core-node
EnvironmentFile=%h/.config/portfolio-os/secrets.env
UnsetEnvironment=_JAVA_OPTIONS
ExecStart=/usr/lib/jvm/java-27-openjdk/bin/java -XX:+UseSerialGC -Xms64m -Xmx192m -XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=48m -Dserver.address=127.0.0.1 --add-opens=java.base/java.nio=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -jar target/core-node-3.0.0.jar
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=portfolio-os.target
