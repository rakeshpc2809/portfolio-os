[Unit]
Description=Portfolio OS Quant Sidecar (Python / FastAPI)
After=network.target
PartOf=portfolio-os.target

[Service]
Type=simple
WorkingDirectory=/home/rakeshpc/Projects/portfolio-os/quant-sidecar
EnvironmentFile=%h/.config/portfolio-os/secrets.env
ExecStart=/usr/bin/uv run python app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=portfolio-os.target
