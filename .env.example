# Portfolio OS Local Environment Configuration
# Copy to .env and adjust if necessary

# Security Tokens (Shared between Core Node and Quant Sidecar)
API_AUTH_TOKEN=dev_secret_key_123
LEDGER_HMAC_SECRET=dev_secret_key_123

# Database Paths (Persistent host-owned Btrfs paths)
DUCKDB_PATH=/home/rakeshpc/Projects/portfolio-os/data/tax_ledger.duckdb
SQLITE_PATH=/home/rakeshpc/Projects/portfolio-os/data/tax_ledger.db

# Inter-Service Networking (Localhost only)
QUANT_SIDECAR_HOST=127.0.0.1
QUANT_SIDECAR_PORT=8000
CORE_NODE_PORT=8080

# Rule Configuration Directory
RULES_DIR=/home/rakeshpc/Projects/portfolio-os/core-node/rules

# JVM Runtime Override
JAVA_HOME=/usr/lib/jvm/java-26-openjdk
